# PyTRIO-Jev training (CLI arguments take precedence)
JEV_DATA=/Users/sunqiyu/AiLLM/document/all_project/all_project/0-expand-prj/Decision-Model-Jev/agentic-rl-lab/09-pytrio-jev/jev/datasets/train.jsonl
JEV_BASE_MODEL=Qwen/Qwen3.5-4B
JEV_LORA_RANK=32
JEV_EPOCHS=1
JEV_BATCH_SIZE=16
JEV_LEARNING_RATE=1e-4
JEV_MAX_SAMPLES=200
JEV_SEED=42
JEV_SAVE_EVERY=60

# Early stopping (dev loss)
JEV_DEV_DATA=/Users/sunqiyu/AiLLM/document/all_project/all_project/0-expand-prj/Decision-Model-Jev/agentic-rl-lab/09-pytrio-jev/jev/datasets/dev.jsonl
JEV_DEV_EVAL_INTERVAL=0.1
JEV_EARLY_STOP_PATIENCE=3

# Resume (断点续训：填 save_state 保存的 trio://... 路径，为空则从头训练)
JEV_RESUME_FROM=trio://run_n84eafcus8lf/weights/pytrio-jev-qwen35-4b-step-240

# SwanLab
JEV_SWANLAB_MODE=online
JEV_SWANLAB_PROJECT=agentic-rl-lab-pytrio-jev

# Leave empty to derive names from JEV_BASE_MODEL.
JEV_EXPERIMENT_NAME=
JEV_WEIGHTS_NAME=

# Inference (CLI arguments take precedence; empty weights/input use the base model/demo)
# Base model is shared with training via JEV_BASE_MODEL above.
JEV_INFERENCE_WEIGHTS=trio://run_t57nr0f94e6e/sampler_weights/pytrio-jev-qwen35-4b-step-252
JEV_INFERENCE_TEMPERATURE=1.0
JEV_INFERENCE_INPUT=
JEV_INFERENCE_LIMIT=1
